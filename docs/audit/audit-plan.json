  "bugs": [
    {
      "id": "BUG-1",
      "title": "audit.md YAML frontmatter silently dropped at runtime",
      "status": "fixed",
      "severity": "high",
      "reportedAt": "2026-07-07T00:30:00+02:00",
      "reportedBy": "claude plugin validate (v0.3.0 release gate)",
      "description": "audit.md's frontmatter description contained ': ' unquoted, so YAML parsing failed and Claude Code loaded the command with EMPTY metadata \u2014 description, argument-hint and allowed-tools never applied, since v0.2.0. init.md's argument-hint parsed as a YAML array instead of a string.",
      "repro": [
        "claude plugin validate plugins/audit",
        "observe: 'YAML frontmatter failed to parse ... loads with empty metadata'"
      ],
      "expected": "All four commands load with their declared metadata.",
      "actual": "audit.md loaded with empty metadata; init.md argument-hint was an array.",
      "files": [
        "plugins/audit/commands/audit.md",
        "plugins/audit/commands/init.md",
        "plugins/audit/commands/task.md",
        "plugins/audit/commands/bug.md"
      ],
      "taskId": "P1.7",
      "fixedIn": "27859f9",
      "notes": "Found by adopting claude plugin validate as a release gate; the gate is now enforced in CI."
    }
  ],
  "deferred": {
    "note": "Consciously cut; each has a revisit trigger.",
    "target": "v0.6+",
    "items": [
      {
        "title": "dry-run / preview mode",
        "reason": "status + the ready-list (and P3.3 report) already answer 'what would run'; a true no-side-effect executor doubles orchestrator complexity.",
        "target": "on demand"
      },
      {
        "title": "plugin-shipped agents/ (audit-explorer/executor/reviewer)",
        "reason": "genuinely promising (pinned tools/models per subagent) but a flagship on its own; shipping it half-baked next to ADO sync violates '3 excellent > 7 mediocre'.",
        "target": "v0.6"
      },
      {
        "title": "Agent-Teams events integration (TaskCreated/TaskCompleted/TeammateIdle)",
        "reason": "build ON the native events once the surface stabilizes, not against it while experimental.",
