.DS_Store
__pycache__/
*.pyc
node_modules/
*.log

# Playwright MCP scratch (visual verification of the report + panel)
.playwright-mcp/

# audit plugin runtime artifacts (this repo dogfoods its own manifest)
docs/audit/*.lock
docs/audit/audit-report.html
docs/audit/audit-report.md
# Written by /audit:report --share before publishing. Same reason as the two above,
# and a sharper one: this form exists only to be handed to a host, so a copy left in
# the tree is a stale duplicate of something whose live version is a URL.
docs/audit/audit-report.artifact.html
# /audit:panel pidfile — holds a live pid, port and session token. Never history.
**/.claude/audit-panel.json

# Per-session hook state and the bypass log. SECURITY.md tells consumers to
# gitignore these; this repo dogfoods the plugin, so it needs the same line — a
# `bash-writes-<session>.json` reached a commit before anyone noticed. No secrets
# in them (session ids, seen-dirty paths, consumed bypasses), but they are local
# scratch that the plugin garbage-collects after 7 days, not history.
.claude/state/
.claude/logs/

# Token-usage ledger. Local by default: it records counts, model ids, timestamps,
# branch and author - never prompt content - but it is per-developer telemetry and
# most repos will not want it in history. To share it across a team instead, delete
# this line and add `*.jsonl merge=union` to .gitattributes: the ledger is
# append-only NDJSON, so a union merge resolves concurrent appends cleanly, and the
# `author` on every row is what makes cross-developer analytics work.
.claude/usage/
